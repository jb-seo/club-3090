@@ -0,0 +1,328 @@
+"""CPU-only Mamba fairness tests using the real tree and leaf-eviction driver."""
+
+import unittest
+from array import array
+from collections import defaultdict
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.components.full_component import FullComponent
+from sglang.srt.mem_cache.unified_cache.components.mamba_component import (
+    MAMBA_REUSED_KEY,
+    MambaComponent,
+)
+from sglang.srt.mem_cache.unified_cache.components.swa_component import SWAComponent
+from sglang.srt.mem_cache.unified_cache.components.tree_component import (
+    ComponentType,
+    LRURefreshPhase,
+)
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import UnifiedTreeCore
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=3, suite="base-a-test-cpu")
+
+FULL, MAMBA, SWA = ComponentType.FULL, ComponentType.MAMBA, ComponentType.SWA
+
+
+def _tree(*, sessions=False, swa=False):
+    components = {FULL: object.__new__(FullComponent)}
+    if swa:
+        components[SWA] = object.__new__(SWAComponent)
+        components[SWA].sliding_window_size = 2
+    components[MAMBA] = object.__new__(MambaComponent)
+    for component in components.values():
+        component.is_evict_device_ongoing = False
+        component.reset_session_state()
+    core = UnifiedTreeCore(
+        SimpleNamespace(
+            page_size=1,
+            is_eagle=False,
+            enable_session_radix_cache=sessions,
+            eviction_policy="lru",
+            token_to_kv_pool_allocator=None,
+            enable_kv_cache_events=False,
+        ),
+        components,
+    )
+    return core, components[MAMBA]
+
+
+def _append_path(core, lengths, parent=None):
+    parent = core.root_node if parent is None else parent
+    path = []
+    for length in lengths:
+        node = core._new_node()
+        node.parent = parent
+        node.key = RadixKey(array("q", [node.id] * length))
+        parent.children[node.key.child_key(core.page_size)] = node
+        for ct in core.component_types:
+            node.component_data[ct].value = torch.full(
+                (1 if ct is MAMBA else length,), node.id, dtype=torch.int64
+            )
+            core.component_evictable_size_[ct] += len(node.component_data[ct].value)
+            if ct is not FULL:
+                core.lru_lists[ct].insert_mru(node)
+        core._update_evictable_leaf_sets(parent)
+        core._update_evictable_leaf_sets(node)
+        path.append(node)
+        parent = node
+    return path
+
+
+def _live(path):
+    return [node for node in path if node.component_data[MAMBA].value is not None]
+
+
+def _lru(core):
+    lru = core.lru_lists[MAMBA]
+    nodes = []
+    node = lru.tail.lru_prev[lru._pt]
+    while node is not lru.head:
+        if lru.in_list(node):
+            nodes.append(node)
+        node = node.lru_prev[lru._pt]
+    return nodes
+
+
+def _evict(core, count, *, already_freed=0, fail_leaf=False):
+    tracker = defaultdict(int, {MAMBA: already_freed})
+    freed = []
+    leaf_calls = []
+
+    def consume(result):
+        for ct, delta in result.tracker.items():
+            tracker[ct] += delta
+        freed.extend(int(value.item()) for value in result.device_frees[MAMBA])
+        # The real cache frees these tensors, then drains the result containers.
+        result.device_frees.clear()
+        result.host_frees.clear()
+
+    core.evict_device_start(MAMBA, already_freed + count)
+    try:
+        for _ in range(1000):
+            result = core.evict_device_next_node(MAMBA, tracker)
+            consume(result)
+            if result.node_id is None:
+                return freed, leaf_calls
+            leaf_calls.append(result.node_id)
+            if not fail_leaf:
+                consume(core.evict_device_leaf(result.node_id, is_write_back=False))
+        raise AssertionError("eviction did not terminate")
+    finally:
+        core.evict_device_end(MAMBA)
+
+
+class TestMambaEvictionFairness(unittest.TestCase):
+    def test_four_paths_contribute_once_in_lru_order(self):
+        for sessions in (False, True):
+            with self.subTest(sessions=sessions):
+                core, component = _tree(sessions=sessions)
+                paths = [_append_path(core, [4, 1, 1, 4]) for _ in range(4)]
+                before = _lru(core)
+                times = {n.id: n.last_access_time for p in paths for n in p}
+                freed, leaves = _evict(core, 4)
+                # Preserve #38000's non-tail min-gap victim in EACH path.
+                self.assertEqual(freed, [path[1].id for path in paths])
+                self.assertEqual(leaves, [])
+                self.assertEqual([len(_live(p)) for p in paths], [3] * 4)
+                self.assertEqual(_lru(core), [n for n in before if n.id not in freed])
+                self.assertTrue(
+                    all(n.last_access_time == times[n.id] for p in paths for n in p)
+                )
+                self.assertTrue(
+                    all(
+                        MAMBA_REUSED_KEY not in n.component_data[MAMBA].metadata
+                        for p in paths
+                        for n in p
+                    )
+                )
+                self.assertEqual(component._evict_paths, {})
+                self.assertEqual(component._evict_path_counts, {})
+                if sessions:
+                    self.assertIsNone(core.lru_lists[MAMBA].cursor.lru_prev[MAMBA])
+
+    def test_multiple_sweeps_retain_two_states_on_every_path(self):
+        for sessions in (False, True):
+            with self.subTest(sessions=sessions):
+                core, _ = _tree(sessions=sessions)
+                paths = [_append_path(core, [1] * 6) for _ in range(4)]
+                owner = {n.id: i for i, p in enumerate(paths) for n in p}
+                freed, _ = _evict(core, 16)
+                self.assertEqual([owner[nid] for nid in freed], [0, 1, 2, 3] * 4)
+                self.assertEqual([len(_live(p)) for p in paths], [2] * 4)
+
+    def test_floor_defers_a_cold_path_until_other_path_reaches_floor(self):
+        core, _ = _tree()
+        cold = _append_path(core, [1, 1])
+        warm = _append_path(core, [1] * 5)
+        freed, _ = _evict(core, 3)
+        self.assertTrue(set(freed) <= {n.id for n in warm})
+        self.assertEqual([len(_live(p)) for p in (cold, warm)], [2, 2])
+
+    def test_surviving_checkpoints_provide_partial_prefix_matches(self):
+        core, _ = _tree()
+        paths = [_append_path(core, [1] * 6) for _ in range(4)]
+        _evict(core, 16)
+        for path in paths:
+            # Each path retains depths 4 and 6. A branch at depth 5 can
+            # resume at 4, instead of losing the entire cached prefix.
+            key = RadixKey(array("q", [node.id for node in path[:5]]))
+            _, best, best_device, device_len, full_len, _ = core._match_prefix_helper(
+                key
+            )
+            self.assertIs(best, path[3])
+            self.assertIs(best_device, path[3])
+            self.assertEqual((device_len, full_len), (4, 5))
+
+    def test_hard_pressure_sacrifices_true_coldest_path(self):
+        for sessions in (False, True):
+            with self.subTest(sessions=sessions):
+                core, _ = _tree(sessions=sessions)
+                paths = [_append_path(core, [1] * 3) for _ in range(2)]
+                owner = {n.id: i for i, p in enumerate(paths) for n in p}
+                freed, leaves = _evict(core, 4)
+                self.assertEqual([owner[nid] for nid in freed], [0, 1, 0, 0])
+                self.assertEqual(leaves, [paths[0][-1].id])
+                self.assertEqual([len(_live(p)) for p in paths], [0, 2])
+
+    def test_both_paths_initially_at_floor_use_hard_lru(self):
+        core, _ = _tree()
+        paths = [_append_path(core, [1, 1]) for _ in range(2)]
+        freed, _ = _evict(core, 2)
+        self.assertEqual(set(freed), {n.id for n in paths[0]})
+        self.assertEqual(len(_live(paths[1])), 2)
+
+    def test_new_episode_starts_at_real_lru_not_last_eviction(self):
+        core, component = _tree()
+        paths = [_append_path(core, [4, 1, 1, 4]) for _ in range(2)]
+        self.assertEqual(_evict(core, 1)[0], [paths[0][1].id])
+        expected = component._thinning_victim(paths[0][0])
+        self.assertEqual(_evict(core, 1)[0], [expected.id])
+
+    def test_leaf_callbacks_keep_quota_across_driver_calls(self):
+        core, _ = _tree(sessions=True)
+        paths = [_append_path(core, [1] * 4) for _ in range(2)]
+        lru = core.lru_lists[MAMBA]
+        # Make A's leaf the oldest node, while preserving B as the next path.
+        for n in paths[0][:-1] + paths[1]:
+            lru.reset_node_mru(n)
+        freed, leaves = _evict(core, 2, already_freed=7)
+        self.assertEqual(freed, [paths[0][-1].id, paths[1][0].id])
+        self.assertEqual(leaves, [paths[0][-1].id])
+
+    def test_floor_protects_leaf_holder_while_other_path_can_thin(self):
+        core, _ = _tree()
+        cold = _append_path(core, [1, 1])
+        warm = _append_path(core, [1] * 4)
+        for n in [cold[0], *warm]:
+            core.lru_lists[MAMBA].reset_node_mru(n)
+        freed, leaves = _evict(core, 1)
+        self.assertEqual(freed, [warm[0].id])
+        self.assertEqual(leaves, [])
+        self.assertEqual(len(_live(cold)), 2)
+
+    def test_protected_non_tail_victims_remain_protected(self):
+        for protection in ("locked", "session", "reused", "load-back"):
+            with self.subTest(protection=protection):
+                core, component = _tree(sessions=True)
+                paths = [_append_path(core, [4, 1, 1, 4]) for _ in range(2)]
+                pinned = paths[0][1]
+                cd = pinned.component_data[MAMBA]
+                if protection == "locked":
+                    cd.lock_ref = 1
+                elif protection == "session":
+                    cd.session_ref = 1
+                    component._refresh_session_partition(pinned)
+                elif protection == "reused":
+                    component.refresh_lru(
+                        LRURefreshPhase.MATCH_END, pinned, core.root_node
+                    )
+                else:
+                    pinned.load_back_pending_id = pinned.id
+                freed, _ = _evict(core, 2)
+                self.assertNotIn(pinned.id, freed)
+                self.assertIsNotNone(cd.value)
+                self.assertIn(paths[1][1].id, freed)
+
