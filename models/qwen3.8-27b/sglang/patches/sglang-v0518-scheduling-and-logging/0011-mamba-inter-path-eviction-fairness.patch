+    def _device_eviction_path(self, node: UnifiedTreeNode) -> tuple[NodeId, int]:
+        """Identify a non-branching segment and its ready device checkpoints.
+
+        A fork ends its incoming segment; each child starts a different one.
+        This does not require sessions to be registered. Shared ancestors do
+        not inflate every child's private checkpoint budget. Cache the result
+        for this sweep only: one victim per path means no recount is needed
+        until the next sweep. Already discovered segments remain separate if
+        deleting a leaf collapses a fork during the driver's IO step.
+        """
+        known = self._evict_paths.get(node.id)
+        if known is not None:
+            return known
+        root = self.tree_core.root_node
+        start = node
+        while (
+            start.parent is not root
+            and len(start.parent.children) == 1
+            and start.parent.id not in self._evict_paths
+        ):
+            start = start.parent
+        path = [start]
+        while len(path[-1].children) == 1:
+            child = next(iter(path[-1].children.values()))
+            if child.id in self._evict_paths:
+                break
+            path.append(child)
+
+        ancestors = []
+        parent = start.parent
+        while parent is not root:
+            ancestors.append(parent)
+            parent = parent.parent
+        # Reuse the real match validators, including SWA's stateful window.
+        # Host-only states and in-flight load-backs do not satisfy this device
+        # floor; neither do execution buffers, which are not tree values.
+        validators = [
+            comp.create_match_validator(match_device_only=True)
+            for comp in self.tree_core.components
+        ]
+        ready_prefix = True
+        retained = 0
+        for index, current in enumerate([*reversed(ancestors), *path]):
+            ready_prefix = (
+                ready_prefix
+                and current.component_data[ComponentType.FULL].value is not None
+                and current.load_back_pending_id is None
+            )
+            # Do not short-circuit stateful validators on an invalid boundary.
+            valid = all([validate(current) for validate in validators])
+            if index >= len(ancestors) and ready_prefix and valid:
+                retained += 1
+        result = (start.id, retained)
+        for current in path:
+            self._evict_paths[current.id] = result
+        return result
+
