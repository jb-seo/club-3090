From: JeongBong Seo <lifeofthanks@gmail.com>
Subject: [PATCH] Fix Mamba slot demand for v0.5.18 request fields

The allocation-demand backport in 0007 reads the newer req.kv Mamba
fields, but v0.5.18 keeps them directly on Req. A fresh request has
kv=None and fails before its first prefill. Read the same fields as
HybridReqToTokenPool.alloc instead of treating missing kv as no state:
COW matches and continuing chunks already own slots and must retain them.

Use real release Req objects in the regression tests, cover fresh and
initialized kv info plus buffer modes, and use the release's cache.evict
API in the test double. Append this fix so existing nine-patch containers
can upgrade without reversing or replacing their installed patches.

---
diff --git a/python/sglang/srt/mem_cache/allocation.py b/python/sglang/srt/mem_cache/allocation.py
index 121d60334c..f1963f7979 100644
--- a/python/sglang/srt/mem_cache/allocation.py
+++ b/python/sglang/srt/mem_cache/allocation.py
@@ -241,9 +241,11 @@ def mamba_slots_needed(
         ping_pong_slots = 0
     needed = 0
     for req in reqs:
-        if not req.kv.holds_mamba:
+        # v0.5.18 keeps Mamba ownership on Req, not its optional ReqKvInfo.
+        # Match HybridReqToTokenPool.alloc, including fresh requests (kv=None).
+        if req.mamba_pool_idx is None:
             needed += 1
-        if req.kv.mamba_ping_pong_track_buffer is None:
+        if req.mamba_ping_pong_track_buffer is None:
             needed += ping_pong_slots
     return needed
 
diff --git a/test/registered/unit/mem_cache/test_mamba_alloc_req_slots_demand.py b/test/registered/unit/mem_cache/test_mamba_alloc_req_slots_demand.py
index 396a39c83c..b99dd06c44 100644
--- a/test/registered/unit/mem_cache/test_mamba_alloc_req_slots_demand.py
+++ b/test/registered/unit/mem_cache/test_mamba_alloc_req_slots_demand.py
@@ -8,13 +8,16 @@ under a tight pool and starved prefix reuse.
 """
 
 import unittest
+from array import array
 from types import SimpleNamespace
 
 import torch
 
+from sglang.srt.managers.schedule_batch import Req, ReqKvInfo
 from sglang.srt.mem_cache.allocation import alloc_req_slots, mamba_slots_needed
 from sglang.srt.mem_cache.base_prefix_cache import EvictParams
 from sglang.srt.mem_cache.memory_pool import HybridReqToTokenPool
+from sglang.srt.sampling.sampling_params import SamplingParams
 from sglang.test.ci.ci_register import register_cpu_ci
 
 register_cpu_ci(est_time=2, suite="base-a-test-cpu")
@@ -29,14 +32,17 @@ def _pool(*, extra_buffer=True, lazy=False, overlap=True):
 
 
 def _req(*, holds_mamba: bool, has_ping_pong: bool):
-    return SimpleNamespace(
-        kv=SimpleNamespace(
-            holds_mamba=holds_mamba,
-            mamba_ping_pong_track_buffer=(
-                torch.tensor([1, 2]) if has_ping_pong else None
-            ),
-        )
+    req = Req(
+        rid="mamba-demand-test",
+        origin_input_text="test",
+        origin_input_ids=array("q", [1, 2]),
+        sampling_params=SamplingParams(),
+    )
+    req.mamba_pool_idx = torch.tensor(0) if holds_mamba else None
+    req.mamba_ping_pong_track_buffer = (
+        torch.tensor([1, 2]) if has_ping_pong else None
     )
+    return req
 
 
 NEW = _req(holds_mamba=False, has_ping_pong=False)
@@ -45,12 +51,35 @@ CHUNKED = _req(holds_mamba=True, has_ping_pong=True)
 
 
 class TestMambaSlotsNeeded(unittest.TestCase):
+    def test_fresh_request_has_no_kv_info(self):
+        self.assertIsNone(NEW.kv)
+        self.assertEqual(mamba_slots_needed(req_to_token_pool=_pool(), reqs=[NEW]), 3)
+
     def test_demand_counts_only_what_alloc_will_take(self):
         pool = _pool()
         self.assertEqual(mamba_slots_needed(req_to_token_pool=pool, reqs=[NEW]), 3)
         self.assertEqual(mamba_slots_needed(req_to_token_pool=pool, reqs=[COW]), 2)
         self.assertEqual(mamba_slots_needed(req_to_token_pool=pool, reqs=[CHUNKED]), 0)
 
+    def test_initialized_kv_info_does_not_own_mamba_state(self):
+        req = _req(holds_mamba=True, has_ping_pong=True)
+        req.kv = ReqKvInfo(kv_allocated_len=2, swa_evicted_seqlen=0)
+        self.assertEqual(mamba_slots_needed(req_to_token_pool=_pool(), reqs=[req]), 0)
+
+    def test_buffer_modes_and_mixed_batch(self):
+        for pool, expected in (
+            (_pool(), 5),
+            (_pool(lazy=True), 3),
+            (_pool(overlap=False), 3),
+            (_pool(extra_buffer=False), 1),
+        ):
+            with self.subTest(pool=pool):
+                self.assertEqual(
+                    mamba_slots_needed(req_to_token_pool=pool, reqs=[NEW, COW, CHUNKED]),
+                    expected,
+                )
+        self.assertEqual(mamba_slots_needed(req_to_token_pool=_pool(), reqs=[]), 0)
+
 
 class _RecordingCache:
     def __init__(self):
@@ -59,7 +88,7 @@ class _RecordingCache:
     def supports_mamba(self):
         return True
 
-    def evict_for_alloc(self, params: EvictParams):
+    def evict(self, params: EvictParams):
         self.evict_params.append(params)
 
 
@@ -75,6 +104,18 @@ def _hybrid_pool(available: int):
 
 
 class TestAllocReqSlotsEviction(unittest.TestCase):
+    def test_fresh_request_evicts_before_alloc(self):
+        cache = _RecordingCache()
+        pool = _hybrid_pool(available=1)
+
+        def allocate(reqs):
+            self.assertEqual(cache.evict_params, [EvictParams(num_tokens=0, mamba_num=2)])
+            self.assertIsNone(reqs[0].kv)
+            return [1]
+
+        pool.alloc = allocate
+        self.assertEqual(alloc_req_slots(pool, [NEW], cache), [1])
+
     def test_evicts_only_the_shortfall(self):
         cache = _RecordingCache()
         # a chunked continuation holds everything already: nothing to evict
