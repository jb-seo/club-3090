diff --git a/python/sglang/srt/mem_cache/unified_cache/history.py b/python/sglang/srt/mem_cache/unified_cache/history.py
new file mode 100644
index 0000000..679c723
--- /dev/null
+++ b/python/sglang/srt/mem_cache/unified_cache/history.py
@@ -0,0 +1,408 @@
+"""Best-effort, process-local cache history. Never reads KV/state contents.
+
+All collection runs on the scheduler thread. CUDA slot IDs are opt-in because
+materializing them on the CPU synchronizes the device. There is no tree-walking
+background thread and no distributed communication in this recorder.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+import logging
+import math
+import os
+import time
+from pathlib import Path
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+
+logger = logging.getLogger(__name__)
+
+
+def _json_default(value):
+    if hasattr(value, "id"):
+        return value.id
+    if type(value).__module__.startswith("numpy") and hasattr(value, "item"):
+        return value.item()
+    return repr(value)
+
+
+def _best_effort(fn):
+    @functools.wraps(fn)
+    def wrapped(self, *args, **kwargs):
+        if not self.enabled:
+            return None
+        try:
+            return fn(self, *args, **kwargs)
+        except Exception as exc:
+            self.close()
+            logger.warning("Cache history disabled after %s: %s", fn.__name__, exc)
+            return None
+
+    return wrapped
+
+
+def history_operation(name):
+    """Correlate nested cache operations without retaining request objects."""
+
+    def decorate(fn):
+        @functools.wraps(fn)
+        def wrapped(self, *args, **kwargs):
+            history = getattr(self, "history", None)
+            if not history:
+                return fn(self, *args, **kwargs)
+            previous = history.context
+            history.begin(name, args, kwargs)
+            try:
+                result = fn(self, *args, **kwargs)
+            except BaseException as exc:
+                history.event(
+                    name + "_end", status="error", error_type=type(exc).__name__
+                )
+                raise
+            else:
+                history.end(name, result, owner=self)
+                return result
+            finally:
+                history.context = previous
+
+        return wrapped
+
+    return decorate
+
+
+class CacheHistory:
+    def __init__(
+        self,
+        directory,
+        *,
+        tp_rank=0,
+        pp_rank=0,
+        interval=30.0,
+        max_bytes=32 * 1024 * 1024,
+        backups=4,
+        max_nodes=10000,
+        slots=False,
+    ):
+        self.enabled = True
+        self.context = {}
+        self.sequence = 0
+        self.operation = 0
+        self.snapshot = 0
+        self.next_snapshot = 0.0
+        self.interval = interval
+        self.max_bytes = max_bytes
+        self.backups = backups
+        self.max_nodes = max_nodes
+        self.slots = slots
+        self.file = None
+        self.bytes_written = 0
+        self.identity = dict(pid=os.getpid(), tp=tp_rank, pp=pp_rank)
+        self.path = Path(directory) / (
+            f"cache-tp{tp_rank}-pp{pp_rank}-pid{os.getpid()}-{time.time_ns()}.jsonl"
+        )
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.event(
+            "history_start",
+            schema=1,
+            interval_seconds=interval,
+            max_bytes=max_bytes,
+            backups=backups,
+            max_nodes=max_nodes,
+            cuda_slot_ids=slots,
+        )
+
+    @classmethod
+    def from_env(cls, **identity):
+        directory = os.environ.get(
+            "SGLANG_CACHE_HISTORY_DIR", "/tmp/sglang_kv_mamba_history"
+        )
+        if directory.lower() in ("", "0", "off", "false"):
+            return None
+        try:
+            interval = float(os.environ.get("SGLANG_CACHE_HISTORY_INTERVAL", "30"))
+            if not math.isfinite(interval) or interval <= 0:
+                raise ValueError("SGLANG_CACHE_HISTORY_INTERVAL must be finite and > 0")
+            history = cls(
+                directory,
+                **identity,
+                interval=interval,
+                max_bytes=max(
+                    1024,
+                    int(os.environ.get("SGLANG_CACHE_HISTORY_MAX_MB", "32"))
+                    * 1024
+                    * 1024,
+                ),
+                backups=max(
+                    1, int(os.environ.get("SGLANG_CACHE_HISTORY_BACKUPS", "4"))
+                ),
+                max_nodes=max(
+                    1, int(os.environ.get("SGLANG_CACHE_HISTORY_MAX_NODES", "10000"))
+                ),
+                slots=os.environ.get("SGLANG_CACHE_HISTORY_SLOTS", "0") == "1",
+            )
+            if history:
+                logger.info("KV/Mamba history: %s", history.path)
+            return history
+        except Exception as exc:
+            logger.warning("Cannot initialize cache history: %s", exc)
+            return None
+
+    def __bool__(self):
+        return self.enabled
+
+    def close(self):
+        self.enabled = False
+        if self.file is not None:
+            try:
+                self.file.close()
+            except Exception:
+                pass
+            self.file = None
+
+    def _rotate(self):
+        if self.file is not None:
+            self.file.close()
+            self.file = None
+        for index in range(self.backups, 0, -1):
+            src = self.path if index == 1 else Path(f"{self.path}.{index - 1}")
+            if src.exists():
+                src.replace(f"{self.path}.{index}")
+        self.bytes_written = 0
+
+    @_best_effort
+    def event(self, event, **fields):
+        row = dict(
+            ts=time.time(),
+            monotonic=time.monotonic(),
+            **self.identity,
+            seq=self.sequence,
+            event=event,
+            **self.context,
+        )
+        row.update(fields)
+        line = (
+            json.dumps(
+                row,
+                ensure_ascii=False,
+                separators=(",", ":"),
+                default=_json_default,
+            )
+            + "\n"
+        )
+        size = len(line.encode("utf-8"))
+        if self.bytes_written and self.bytes_written + size > self.max_bytes:
+            self._rotate()
+        if self.file is None:
+            self.file = self.path.open("a", encoding="utf-8", buffering=1)
+        self.file.write(line)
+        self.bytes_written += size
+        self.sequence += 1
+
+    def value(self, value):
+        if value is None:
+            return None
+        count = value.numel() if hasattr(value, "numel") else len(value)
+        info = {"count": count}
+        device = getattr(value, "device", None)
+        if device is None:
+            info["ids"] = list(value)
+        elif device.type == "cpu" or self.slots:
+            info["ids"] = value.reshape(-1).tolist()
+        else:
+            info["ids_omitted"] = "cuda_sync_disabled"
+        return info
+
+    @_best_effort
+    def request(self, event, req, **fields):
+        for key, value in list(fields.items()):
+            if hasattr(value, "numel"):
+                fields[key] = self.value(value)
+        self.event(
+            event,
+            rid=getattr(req, "rid", None),
+            req_pool_idx=getattr(req, "req_pool_idx", None),
+            active=self.value(getattr(req, "mamba_pool_idx", None)),
+            tracking=self.value(getattr(req, "mamba_ping_pong_track_buffer", None)),
+            track_depth=getattr(req, "mamba_last_track_seqlen", None),
+            **fields,
+        )
+
+    def node_info(self, core, node, depth=None):
+        path_nodes = None
+        if depth is None:
+            depth = 0
+            ancestor = node
+            path_nodes = []
+            while ancestor is not None:
+                path_nodes.append(ancestor.id)
+                if ancestor is not core.root_node:
+                    depth += len(ancestor.key)
+                ancestor = ancestor.parent
+            path_nodes.reverse()
+        components = {}
+        for ct in core.component_types:
+            cd = node.component_data[ct]
+            data = dict(
+                device_count=0 if cd.value is None else len(cd.value),
+                host_count=0 if cd.host_value is None else len(cd.host_value),
+                lock_ref=cd.lock_ref,
+                host_lock_ref=cd.host_lock_ref,
+                session_ref=cd.session_ref,
+                session_ids=sorted(cd.session_ids or ()),
+            )
+            if ct == ComponentType.MAMBA:
+                data.update(
+                    device_slots=self.value(cd.value),
+                    host_slots=self.value(cd.host_value),
+                    reused=bool(cd.metadata.get("mamba_reused")),
+                )
+            components[ct.name] = data
+        result = dict(
+            node=node.id,
+            parent=node.parent.id if node.parent else None,
+            depth=depth,
+            edge_tokens=len(node.key),
+            token_range=[depth - len(node.key), depth],
+            children=len(node.children),
+            lru_tick=node.last_access_time,
+            creation_tick=node.creation_time,
+            hit_count=node.hit_count,
+            priority=node.priority,
+            device_leaf=node in core.evictable_device_leaves,
+            host_leaf=node in core.evictable_host_leaves,
+            load_back_pending=node.load_back_pending_id,
+            write_through_pending=node.write_through_pending_id,
+            components=components,
+        )
+        if path_nodes is not None:
+            result["path_nodes"] = path_nodes
+        return result
+
+    @_best_effort
+    def node(self, event, core, node, **fields):
+        self.event(event, **self.node_info(core, node), **fields)
+
+    @_best_effort
+    def begin(self, name, args, kwargs):
+        self.operation += 1
+        context = dict(
+            self.context, op=self.operation, parent_op=self.context.get("op")
+        )
+        arg = args[0] if args else kwargs.get("req", kwargs.get("params"))
+        req = getattr(arg, "req", arg)
+        if getattr(req, "rid", None) is not None:
+            context["rid"] = req.rid
+        self.context = context
+        fields = {}
+        for field in (
+            "num_tokens",
+            "mamba_num",
+            "swa_num_tokens",
+            "chunked",
+            "cow_mamba",
+        ):
+            if hasattr(arg, field):
+                fields[field] = getattr(arg, field)
+        self.event(name + "_begin", **fields)
+
+    @_best_effort
+    def end(self, name, result, owner=None):
+        fields = {}
+        for field in (
+            "num_tokens_evicted",
+            "mamba_num_evicted",
+            "swa_num_tokens_evicted",
+            "prefix_len",
+            "total_len",
+            "last_device_node",
+            "best_match_node",
+            "host_hit_length",
+            "full_kv_hit_length",
+            "mamba_host_hit_length",
+            "mamba_branching_seqlen",
+            "mamba_exist",
+        ):
+            if hasattr(result, field):
+                fields[field] = getattr(result, field)
+        if owner is not None and hasattr(owner, "tree_core"):
+            node_ref = fields.get("last_device_node", fields.get("best_match_node"))
+            if node_ref is not None:
+                node = (
+                    node_ref
+                    if hasattr(node_ref, "component_data")
+                    else owner.tree_core.node_by_id(node_ref)
+                )
+                fields["result_node"] = self.node_info(owner.tree_core, node)
+        self.event(name + "_end", status="ok", **fields)
+
+    def due(self):
+        return self.enabled and time.monotonic() >= self.next_snapshot
+
+    def pools(self, cache):
+        result = {}
+        pool = cache.req_to_token_pool
+        for name, allocator in (
+            ("kv", cache.token_to_kv_pool_allocator),
+            ("mamba", getattr(pool, "mamba_allocator", None)),
+            ("mamba_int8", getattr(pool, "mamba_ckpt_pool", None)),
+        ):
+            if allocator is not None:
+                data = {"available": allocator.available_size()}
+                if hasattr(allocator, "schedulable_available_size"):
+                    data["schedulable_available"] = (
+                        allocator.schedulable_available_size()
+                    )
+                result[name] = data
+        return result
+
+    @_best_effort
+    def maybe_snapshot(self, cache, requests=(), *, force=False):
+        if not force and not self.due():
+            return
+        self.next_snapshot = time.monotonic() + self.interval
+        self.snapshot += 1
+        sid = self.snapshot
+        core = cache.tree_core
+        self.event(
+            "snapshot_begin",
+            snapshot=sid,
+            root=core.root_node.id,
+            pools=self.pools(cache),
+            evictable={ct.name: n for ct, n in core.component_evictable_size_.items()},
+            protected={ct.name: n for ct, n in core.component_protected_size_.items()},
+            device_leaves=len(core.evictable_device_leaves),
+            host_leaves=len(core.evictable_host_leaves),
+        )
+        count = 0
+        stack = [(core.root_node, 0)]
+        while stack and count < self.max_nodes:
+            node, depth = stack.pop()
+            self.event(
+                "snapshot_node", snapshot=sid, **self.node_info(core, node, depth)
+            )
+            count += 1
+            stack.extend(
+                (child, depth + len(child.key)) for child in node.children.values()
+            )
+        # Snapshot request rows describe scheduler-visible live/queued requests;
+        # they are not an assertion of exclusive ownership of shared prefixes.
+        seen = set()
+        for req in requests:
+            if id(req) not in seen:
+                self.request(
+                    "snapshot_request",
+                    req,
+                    snapshot=sid,
+                    last_node=getattr(req, "last_node", None),
+                    kv_committed_len=getattr(req, "kv_committed_len", None),
+                )
+                seen.add(id(req))
+        self.event(
+            "snapshot_end",
+            snapshot=sid,
+            nodes=count,
+            truncated=bool(stack),
+            requests=len(seen),
+        )
