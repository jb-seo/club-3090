diff --git a/test/registered/unit/mem_cache/test_cache_history.py b/test/registered/unit/mem_cache/test_cache_history.py
new file mode 100644
index 0000000..b5bff6d
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_cache_history.py
@@ -0,0 +1,86 @@
+"""CPU coverage for the opt-out cache history recorder."""
+
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+from test_mamba_eviction_fairness import _append_path, _evict, _tree
+
+from sglang.srt.mem_cache.unified_cache.history import CacheHistory
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class _Allocator:
+    def __init__(self, available):
+        self.available = available
+
+    def available_size(self):
+        return self.available
+
+
+class TestCacheHistory(unittest.TestCase):
+    def test_snapshot_and_mamba_eviction_are_correlated_jsonl(self):
+        core, mamba = _tree()
+        path = _append_path(core, [20, 20, 20])
+
+        with tempfile.TemporaryDirectory() as directory:
+            history = CacheHistory(
+                directory,
+                tp_rank=1,
+                pp_rank=0,
+                interval=30,
+                max_bytes=1024 * 1024,
+                backups=2,
+                max_nodes=100,
+            )
+            cache = SimpleNamespace(
+                history=history,
+                tree_core=core,
+                token_to_kv_pool_allocator=_Allocator(123),
+                req_to_token_pool=SimpleNamespace(
+                    mamba_allocator=_Allocator(7), mamba_ckpt_pool=None
+                ),
+            )
+            mamba.cache = cache
+
+            history.maybe_snapshot(cache, force=True)
+            _evict(core, 1)
+            history.close()
+
+            rows = [
+                json.loads(line)
+                for line in Path(history.path).read_text(encoding="utf-8").splitlines()
+            ]
+
+        events = [row["event"] for row in rows]
+        self.assertEqual(rows[0]["event"], "history_start")
+        self.assertIn("snapshot_begin", events)
+        self.assertEqual(events.count("snapshot_node"), len(path) + 1)
+        self.assertIn("mamba_pressure_victim_selected", events)
+        self.assertIn("mamba_state_evict_done", events)
+        self.assertEqual({row["tp"] for row in rows}, {1})
+
+        snapshot = next(row for row in rows if row["event"] == "snapshot_begin")
+        self.assertEqual(snapshot["pools"]["kv"]["available"], 123)
+        victim = next(
+            row for row in rows if row["event"] == "mamba_pressure_victim_selected"
+        )
+        self.assertEqual(victim["mode"], "fair")
+        self.assertIn(victim["node"], [node.id for node in path])
+        self.assertEqual(victim["path_nodes"][0], core.root_node.id)
+        self.assertEqual(victim["token_range"][1], victim["depth"])
+
+    def test_environment_can_disable_history(self):
+        import os
+        from unittest.mock import patch
+
+        with patch.dict(os.environ, {"SGLANG_CACHE_HISTORY_DIR": "off"}):
+            self.assertIsNone(CacheHistory.from_env(tp_rank=0, pp_rank=0))
+
+
+if __name__ == "__main__":
+    unittest.main()

