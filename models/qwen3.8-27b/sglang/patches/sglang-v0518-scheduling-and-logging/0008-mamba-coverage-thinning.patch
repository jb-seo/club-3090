+++ b/python/sglang/srt/mem_cache/unified_cache/components/mamba_component.py
@@ -401,22 +401,91 @@ class MambaComponent(TreeComponent):
                     lru.cursor_next() if enabled else lru.get_prev_no_lock(x)
                 )
                 return x.id
+            victim = self._thinning_victim(x)
+            if victim is not x:
+                # Keep the cursor on x and re-evaluate its chain until enough
+                # slots are freed or a device leaf is returned to the driver.
+                self._tombstone_device_state(victim, tracker, device_frees, host_frees)
+                continue
             if not enabled:
                 x_next = lru.get_prev_no_lock(x)
-            self.tree_core._evict_component_and_detach_lru(
-                x,
-                self,
-                target=EvictLayer.DEVICE,
-                tracker=tracker,
-                device_frees=device_frees,
-                host_frees=host_frees,
-            )
