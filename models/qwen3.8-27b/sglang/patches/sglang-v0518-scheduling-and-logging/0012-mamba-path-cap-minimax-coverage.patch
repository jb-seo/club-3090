+def _path_cap_coverage_score(
+    depths: Sequence[int], path_start_depth: int = 0
+) -> tuple[int, int]:
+    """Minimax replay gap, then uniform-quantile deviation, for sorted depths.
+
+    Multiply deviation by the survivor count to use integer arithmetic only.
+    All candidates in one decision have the same count and mandatory frontier,
+    so this preserves the ordering of the exact fractional deviations.
+    Protected retained holders naturally bound the gaps on either side.
+    """
+    count = len(depths)
+    if not count:
+        return 0, 0
+    span = depths[-1] - path_start_depth
+    previous = path_start_depth
+    max_gap = deviation = 0
+    for rank, depth in enumerate(depths, 1):
+        max_gap = max(max_gap, depth - previous)
+        deviation += abs(count * (depth - path_start_depth) - rank * span)
+        previous = depth
+    return max_gap, deviation
+
 
