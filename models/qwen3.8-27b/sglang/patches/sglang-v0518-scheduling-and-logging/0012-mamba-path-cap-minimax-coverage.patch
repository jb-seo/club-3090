+    def _choose_path_cap_victim(
+        self, holders: Sequence[tuple[int, UnifiedTreeNode]], tail: UnifiedTreeNode
+    ) -> Optional[UnifiedTreeNode]:
+        """Choose among existing states; the inserted frontier is mandatory.
+
+        Keep this separate from #38000's cold-path neighbour-gap selector:
+        here every candidate is scored against ALL surviving checkpoints.
+        Equal minimax/deviation scores evict the deeper state, retaining older
+        historical coverage, then use node ID for a deterministic final tie.
+        """
+        candidates = []
+        protected = []
+        for depth, node in holders:
+            cd = node.component_data[self.component_type]
+            if (
+                node is tail
+                or len(node.children) != 1
+                or cd.lock_ref > 0
+                or cd.session_ref > 0
+                or cd.metadata.get(MAMBA_REUSED_KEY)
+                or node.load_back_pending_id is not None
+                or node in self.tree_core.evictable_device_leaves
+            ):
+                protected.append(depth)
+                continue
+            survivors = [d for d, holder in holders if holder is not node]
+            score = (*_path_cap_coverage_score(survivors), -depth, node.id)
+            candidates.append((score, node))
+        chosen = (
+            min(candidates, key=lambda candidate: candidate[0]) if candidates else None
+        )
+        if logger.isEnabledFor(logging.DEBUG):
+            before = [depth for depth, _ in holders]
+            after = [
+                d for d, node in holders if chosen is None or node is not chosen[1]
+            ]
+            logger.debug(
+                "Mamba path cap: tail=%s cap=%d path_start_depth=0 frontier_depth=%d "
+                "holders_before=%s protected=%s candidate_scores=%s chosen=%s "
+                "holders_after=%s max_gap_before=%d max_gap_after=%d",
+                tail.id,
+                self.mamba_max_states_per_path,
+                before[-1],
+                before,
+                protected,
+                [score for score, _ in candidates],
+                chosen[1].id if chosen else None,
+                after,
+                _path_cap_coverage_score(before)[0],
+                _path_cap_coverage_score(after)[0],
+            )
+        return chosen[1] if chosen else None
 
