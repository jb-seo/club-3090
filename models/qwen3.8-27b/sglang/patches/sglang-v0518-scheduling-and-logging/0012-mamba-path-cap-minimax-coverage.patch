index 0000000..da45f4a
--- /dev/null
+++ b/test/manual/mem_cache/benchmark_mamba_path_cap.py
@@ -0,0 +1,207 @@
+"""CPU policy A/B on real tree, eviction and prefix-match code; no model timing.
+
+Run with python/ on PYTHONPATH. JSON goes to stdout. The legacy arm models
+the pre-0012 shallow-first cap; both arms use the current global eviction.
+Diagnostic probes do not refresh recency or mark checkpoints as reused.
+"""
+
+import argparse
+import json
+import statistics
+import sys
+import time
+from array import array
+from collections import defaultdict
+from pathlib import Path
+from types import SimpleNamespace
+
+sys.path.insert(
+    0, str(Path(__file__).resolve().parents[2] / "registered/unit/mem_cache")
+)
+
+from test_mamba_eviction_fairness import FULL, MAMBA, _append_path, _evict, _tree
+
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.components.tree_component import EvictLayer
+
+
+def legacy_cap(component, tail, device, host):
+    """The previous root-to-tail shallow-first policy, for this A/B only."""
+    holders = []
+    node = tail
+    while node is not component.tree_core.root_node:
+        if node.component_data[MAMBA].value is not None:
+            holders.append(node)
+        node = node.parent
+    excess = len(holders) - component.mamba_max_states_per_path
+    tracker = defaultdict(int)
+    for node in reversed(holders):
+        if excess <= 0 or node is tail:
+            break
+        if node.component_data[MAMBA].lock_ref > 0 or len(node.children) != 1:
+            continue
+        if node in component.tree_core.evictable_device_leaves:
+            continue
+        component.tree_core._evict_component_and_detach_lru(
+            node, component, device, host, target=EvictLayer.DEVICE, tracker=tracker
+        )
+        component.tree_core._cascade_evict(node, component, tracker, device, host)
+        excess -= 1
+
+
+def chain(core, tail):
+    nodes = []
+    while tail is not core.root_node:
+        nodes.append(tail)
+        tail = tail.parent
+    return list(reversed(nodes))
+
+
+def geometry(core, tail):
+    depth, retained = 0, []
+    for node in chain(core, tail):
+        depth += len(node.key)
+        if node.component_data[MAMBA].value is not None:
+            retained.append(depth)
+    points = [0, *retained]
+    if points[-1] != depth:
+        points.append(depth)
+    return retained, max((b - a for a, b in zip(points, points[1:])), default=0)
+
+
+def run(policy, sessions, pool_size, turns, cap, execution_slots):
+    core, component = _tree()
+    component.cache = SimpleNamespace(tree_components=core.component_types)
+    component.mamba_max_states_per_path = cap
+    budget = pool_size - execution_slots
+    tails = [core.root_node] * sessions
+    cap_evicted = pressure_evicted = peak = settled_peak = frontier_rebuilds = 0
+    probes = []
+    cap_us = []
+    snapshots = []
+    for turn in range(turns):
+        for session in range(sessions):
+            occupied = core.component_evictable_size_[MAMBA]
+            # Reserve space before committing the new persistent checkpoint.
+            shortage = max(0, occupied + 1 - budget)
+            if shortage:
+                freed, _ = _evict(core, shortage)
+                assert len(freed) == shortage
+                pressure_evicted += len(freed)
+            tail = tails[session]
+            # Global Mamba pressure can delete a device leaf, including Full
+            # KV. Model its recomputation on the next turn, retaining original
+            # prefix tokens and committing only the new frontier checkpoint.
+            missing = []
+            while tail is not core.root_node and (
+                tail.id not in core._node_arena
+                or tail.component_data[FULL].value is None
+            ):
+                missing.append(tail.key.token_ids)
+                tail = tail.parent
+            increment = (2048, 4096, 3072, 5120)[(turn + session) % 4]
+            restored_tokens = array("q")
+            for tokens in reversed(missing):
+                restored_tokens.extend(tokens)
+            tail = _append_path(core, [len(restored_tokens) + increment], parent=tail)[
+                0
+            ]
+            if missing:
+                frontier_rebuilds += 1
+                tail.parent.children.pop(tail.key.child_key(core.page_size))
+                restored_tokens.extend([tail.id] * increment)
+                tail.key = RadixKey(restored_tokens)
+                tail.parent.children[tail.key.child_key(core.page_size)] = tail
+            tails[session] = tail
+            peak = max(peak, core.component_evictable_size_[MAMBA])
+            device, host = defaultdict(list), defaultdict(list)
+            begin = time.perf_counter_ns()
+            if policy == "legacy":
+                legacy_cap(component, tail, device, host)
+            else:
+                component._evict_excess_path_states(tail, device, host)
+            cap_us.append((time.perf_counter_ns() - begin) / 1000)
+            cap_evicted += len(device[MAMBA])
+            settled_peak = max(settled_peak, core.component_evictable_size_[MAMBA])
+            assert len(geometry(core, tail)[0]) <= cap
+            assert core.component_evictable_size_[MAMBA] <= budget
+
+        if turn >= 3:
+            for session, tail in enumerate(tails):
+                tokens = array("q")
+                for node in chain(core, tail):
+                    tokens.extend(node.key.token_ids)
+                for percent in (25, 50, 75, 90):
+                    query_len = len(tokens) * percent // 100
+                    values, _, _, parts, _, _ = core._match_prefix_helper(
+                        RadixKey(tokens[:query_len])
+                    )
+                    hit = sum(len(value) for value in values[:parts])
+                    probes.append(
+                        {
+                            "turn": turn + 1,
+                            "session": session,
+                            "query_tokens": query_len,
+                            "hit_tokens": hit,
+                            "replay_tokens": query_len - hit,
+                        }
+                    )
+        snapshots.append(
+            {
+                "turn": turn + 1,
+                "occupied_cached_slots": core.component_evictable_size_[MAMBA],
+                "sessions": [
+                    {
+                        "session": i,
+                        "retained_depths": geometry(core, tail)[0],
+                        "max_replay_gap": geometry(core, tail)[1],
+                    }
+                    for i, tail in enumerate(tails)
+                ],
+            }
+        )
+
+    return {
+        "policy": policy,
+        "sessions": sessions,
+        "turns": turns,
+        "cap": cap,
+        "pool_size": pool_size,
+        "reserved_execution_slots": execution_slots,
+        "cached_slot_budget": budget,
+        "peak_cached_slots_including_new_candidate": peak,
+        "peak_cached_slots_after_cap": settled_peak,
+        "cap_evictions": cap_evicted,
+        "global_pressure_evictions": pressure_evicted,
+        "frontier_rebuilds_after_global_leaf_eviction": frontier_rebuilds,
+        "partial_hit_rate": sum(0 < p["hit_tokens"] < p["query_tokens"] for p in probes)
+        / len(probes),
+        "zero_hit_rate": sum(p["hit_tokens"] == 0 for p in probes) / len(probes),
+        "mean_replay_tokens": statistics.mean(p["replay_tokens"] for p in probes),
+        "cpu_cap_decision_median_us": statistics.median(cap_us),
+        "ttft_ms": None,
+        "snapshots": snapshots,
+        "probes": probes,
+    }
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--turns", type=int, default=24)
+    parser.add_argument("--cap", type=int, default=3)
+    args = parser.parse_args()
+    if args.turns < 4 or args.cap < 1:
+        parser.error("use at least four turns and a positive cap")
+    print(
+        json.dumps(
+            {
+                "scope": "Synthetic CPU tree policy; resident Full KV, independent paths, no locks/session pins/real reuse marks. Prefix probes assess replay capability; no GPU inference. Execution reserve is a modeling input, not measured allocator demand. TTFT is unmeasured; replay tokens are a work proxy.",
+                "scenarios": [
+                    run(policy, sessions, pool, args.turns, args.cap, 4)
+                    for sessions, pool in ((4, 16), (8, 24), (12, 32))
+                    for policy in ("legacy", "coverage")
+                ],
+            },
+            indent=2,
+        )
+    )
