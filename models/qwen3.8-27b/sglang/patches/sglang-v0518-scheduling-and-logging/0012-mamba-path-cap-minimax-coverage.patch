@@ -0,0 +1,280 @@
+"""Coverage-cap decisions on CPU trees, including global-eviction integration."""
+
+import itertools
+import unittest
+from array import array
+from collections import defaultdict
+from fractions import Fraction
+from types import SimpleNamespace
+
+from test_mamba_eviction_fairness import FULL, MAMBA, _append_path, _evict, _lru, _tree
+
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.components.mamba_component import (
+    MAMBA_REUSED_KEY,
+    _path_cap_coverage_score,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=3, suite="base-a-test-cpu")
+
+
+def _setup(cap=3, *, sessions=False):
+    core, component = _tree(sessions=sessions)
+    component.cache = SimpleNamespace(tree_components=core.component_types)
+    component.mamba_max_states_per_path = cap
+    return core, component
+
+
+def _path(core, depths, parent=None):
+    previous = 0
+    lengths = []
+    for depth in depths:
+        lengths.append(depth - previous)
+        previous = depth
+    return _append_path(core, lengths, parent=parent)
+
+
+def _cap(component, tail):
+    device, host = defaultdict(list), defaultdict(list)
+    component._evict_excess_path_states(tail, device, host)
+    return [int(value.item()) for value in device[MAMBA]]
+
+
+def _depths(path):
+    result = []
+    depth = 0
+    for node in path:
+        depth += len(node.key)
+        if node.component_data[MAMBA].value is not None:
+            result.append(depth)
+    return result
+
+
+class TestMambaPathCapCoverage(unittest.TestCase):
+    def test_basic_example_replaces_near_frontier_not_oldest(self):
+        core, component = _setup()
+        path = _path(core, [20, 40, 60, 70])
+        self.assertEqual(_cap(component, path[-1]), [path[2].id])
+        self.assertEqual(_depths(path), [20, 40, 70])
+        # The old shallow-first policy left [40, 60, 70], with a gap of 40.
+        self.assertEqual(_path_cap_coverage_score(_depths(path))[0], 30)
+
+    def test_exhaustive_small_paths_match_global_minimax_and_tiebreaks(self):
+        for count in (2, 3, 4):
+            for depths in itertools.combinations(range(1, 9), count + 1):
+                core, component = _setup(count)
+                path = _path(core, depths)
+                # Independent exhaustive survivor oracle, with exact fractions.
+                choices = []
+                for victim in range(count):
+                    kept = [d for i, d in enumerate(depths) if i != victim]
+                    gaps = [b - a for a, b in zip([0, *kept], kept)]
+                    deviation = sum(
+                        abs(Fraction(d) - Fraction(rank * kept[-1], count))
+                        for rank, d in enumerate(kept, 1)
+                    )
+                    choices.append(((max(gaps), deviation, -depths[victim]), victim))
+                expected = min(choices)[1]
+                self.assertEqual(_cap(component, path[-1]), [path[expected].id], depths)
+
+    def test_whole_path_score_differs_from_local_neighbour_gap(self):
+        core, component = _setup(4)
+        path = _path(core, [10, 11, 20, 30, 100])
+        # The 30->100 gap dominates globally. Local merging prefers depth 11;
+        # equal global maxima instead choose depth 10 by quantile deviation.
+        self.assertIs(component._thinning_victim(path[0]), path[1])
+        self.assertEqual(_cap(component, path[-1]), [path[0].id])
+
+    def test_integer_score_handles_large_depths_and_nonzero_origin(self):
+        start = 2**60
+        self.assertEqual(
+            _path_cap_coverage_score([start + 20, start + 40, start + 70], start),
+            (30, 30),
+        )
+
+    def test_equal_geometry_keeps_older_history(self):
+        for sessions in (False, True):
+            core, component = _setup(2, sessions=sessions)
+            path = _path(core, [1, 2, 3])
+            for node in path:
+                core.lru_lists[MAMBA].reset_node_mru(node)
+            self.assertEqual(_cap(component, path[-1]), [path[1].id])
+            self.assertEqual(_depths(path), [1, 3])
+
+    def test_growing_frontier_moves_anchors_and_never_exceeds_cap(self):
+        core, component = _setup()
+        path = []
+        previous = 0
+        snapshots = []
+        for frontier in (20, 40, 60, 70, 90, 120, 160, 200, 260, 320):
+            path.extend(
+                _append_path(
+                    core, [frontier - previous], parent=path[-1] if path else None
+                )
+            )
+            _cap(component, path[-1])
+            retained = _depths(path)
+            self.assertLessEqual(len(retained), 3)
+            self.assertEqual(retained[-1], frontier)
+            snapshots.append(retained)
+            previous = frontier
+        self.assertEqual(snapshots[3], [20, 40, 70])
+        self.assertGreater(snapshots[-1][0], 20)
+        self.assertLess(snapshots[-1][0], 200)
+        self.assertLessEqual(_path_cap_coverage_score(snapshots[-1])[0], 160)
+
+    def test_each_existing_protection_excludes_geometrically_best_victim(self):
+        for protection in (
+            "reused",
+            "fork",
+            "locked",
+            "session",
+            "load_back",
+            "device_leaf",
+        ):
+            with self.subTest(protection=protection):
+                core, component = _setup(sessions=True)
+                path = _path(core, [20, 40, 60, 70])
+                node = path[2]
+                cd = node.component_data[MAMBA]
+                if protection == "reused":
+                    cd.metadata[MAMBA_REUSED_KEY] = True
+                elif protection == "fork":
+                    _append_path(core, [1], parent=node)
+                elif protection == "locked":
+                    cd.lock_ref = 1
+                elif protection == "session":
+                    cd.session_ref = 1
+                    component._refresh_session_partition(node)
+                elif protection == "load_back":
+                    node.load_back_pending_id = node.id
+                else:
+                    core.evictable_device_leaves.add(node)
+                freed = _cap(component, path[-1])
+                self.assertEqual(len(freed), 1)
+                self.assertNotIn(node.id, freed)
+                self.assertIsNotNone(cd.value)
+                self.assertEqual(_depths(path)[-1], 70)
+
+    def test_cap_one_always_keeps_frontier_even_when_internal(self):
+        core, component = _setup(1)
+        path = _path(core, [20, 40, 60, 70])
+        child = _append_path(core, [10], parent=path[-1])[0]
+        self.assertEqual(len(_cap(component, path[-1])), 3)
+        self.assertEqual(_depths(path), [70])
+        self.assertIsNotNone(child.component_data[MAMBA].value)
+
+    def test_cap_two_keeps_history(self):
